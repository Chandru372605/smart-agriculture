# AgroSense — Environment Configuration
# Copy this file to .env and fill in values before deploying.

# ── Flask ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# Default: SQLite (no configuration needed for local dev)
# For production, switch to PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agrosense

# ── Upload limits ────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ── OpenWeatherMap ───────────────────────────────────────────────────
# Free tier: 60 calls/min, 1000 calls/day — sufficient for AgroSense
# Sign up at: https://openweathermap.org/api  → "Current Weather Data" (free)
WEATHER_API_KEY=your_openweathermap_api_key_here
