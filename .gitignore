# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ──────────────────────────
venv/
env/
.venv/
ENV/

# ── ML model files ──────────────────────────────────────────────────────────
